generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    USER
    ADMIN
}

enum Plan {
    FREE
    PRO
    MAX
}

enum PostType {
    NOTES
    PYQS
    VIDEO
    QUIZ
    FLASHCARD
}

enum PaymentStatus {
    PENDING
    COMPLETED
    FAILED
    REFUNDED
}

enum SubscriptionStatus {
    ACTIVE
    CANCELED
    EXPIRED
    PAST_DUE
}

enum ReferralStatus {
    PENDING
    COMPLETED
    CANCELED
}

enum College {
    VJTI
    ICT_MUMBAI
    SPIT
    DJ_SANGHVI
    THADOMAL
    NMIMS
    MITHIBAI
    HR_COLLEGE
    KC_COLLEGE
    JAI_HIND
    SYDENHAM
    ST_XAVIERS
    WILSON
    RUPAREL
    SIES
    VIVEKANAND
    FR_ANGEL
    VESIT
    TCET
    TSEC
    KJ_SOMAIYA
    BHAVANS
    FATHER_ANGEL
    SABOO_SIDDik
    DON_BOSCO
    TERNA
    ATHARVA
    RAIT
    PILLAI
    BHARATI_VIDYAPEETH
    DATTA_MEGHE
    LOKMANYA
    ST_FRANCIS
    VIVA
    ANNASAHEB_VARTAK
    MGM
    SOMAIYA_VIDYAVIHAR
    RIZVI
    NATIONAL_COLLEGE
    ELPHINSTONE
    GOVERNMENT_LAW
    GLS
    JBIMS
    SP_JAIN
    NL_DALMIA
    TISS
    IIT_BOMBAY
    IITM_JANAKPURI
    AMITY
    MANIPAL
    SYMBIOSIS
    OTHER
}

enum YearOfStudy {
    ONE
    TWO
    THREE
    FOUR
    FIVE
    SIX
}

model User {
    id            String  @id @default(uuid())
    name          String
    email         String  @unique
    username      String  @unique
    emailVerified Boolean @default(false)
    image         String?

    role Role @default(USER)
    plan Plan @default(FREE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    sessions Session[]
    accounts Account[]

    posts    Post[]
    comments Comment[]

    payments      Payment[]
    subscriptions Subscription[]

    referralCode  ReferralCode?
    referralsSent Referral[]    @relation("ReferralSender")
    referralsUsed Referral[]    @relation("ReferralReceiver")

    studentProfile StudentProfile?
    postBookmarks  PostBookmark[]

    @@map("user")
}

model StudentProfile {
    id String @id @default(uuid())

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    course       String?
    university   String?
    college      College?
    academicYear String?
    year         YearOfStudy?
    semester     Int?

    bio String?

    instagram String?
    linkedin  String?
    github    String?
    twitter   String?
    website   String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([college])
    @@index([year])
    @@map("student_profile")
}

model Session {
    id        String   @id @default(uuid())
    expiresAt DateTime
    token     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    ipAddress String?
    userAgent String?

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("session")
}

model Account {
    id         String @id @default(uuid())
    issuer     String
    accountId  String
    providerId String

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?

    scope    String?
    password String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([issuer, accountId])
    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id @default(uuid())
    identifier String
    value      String
    expiresAt  DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

model Post {
    id          String  @id @default(uuid())
    title       String
    slug        String  @unique
    description String?

    type      PostType
    published Boolean  @default(false)
    isPremium Boolean  @default(false)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    noteId String?
    note   Note?   @relation(fields: [noteId], references: [id], onDelete: SetNull)

    videoId String?
    video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

    quizId String?
    quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: SetNull)

    flashcardId String?
    flashcard   Flashcard? @relation(fields: [flashcardId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    comments      Comment[]
    postBookmarks PostBookmark[]

    @@index([userId])
    @@index([type])
    @@index([published])
    @@index([isPremium])
    @@map("post")
}

model Note {
    id          String  @id @default(uuid())
    title       String
    description String?
    fileUrl     String

    fileName String?
    fileSize Int?
    mimeType String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    posts Post[]

    @@map("note")
}

model Video {
    id          String  @id @default(uuid())
    title       String
    description String?

    url       String
    thumbnail String?
    duration  Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    posts Post[]

    @@map("video")
}

model Quiz {
    id          String  @id @default(uuid())
    title       String
    description String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    posts     Post[]
    questions QuizQuestion[]

    @@map("quiz")
}

model QuizQuestion {
    id       String   @id @default(uuid())
    question String
    options  String[]
    answer   Int

    quizId String
    quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([quizId])
    @@map("quiz_question")
}

model Flashcard {
    id       String @id @default(uuid())
    question String
    answer   String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    posts Post[]

    @@map("flashcard")
}

model Comment {
    id      String @id @default(uuid())
    content String

    postId String
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([postId])
    @@index([userId])
    @@map("comment")
}

model Subscription {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    plan Plan

    status                 SubscriptionStatus @default(ACTIVE)
    provider               String?
    providerCustomerId     String?
    providerSubscriptionId String?

    startDate DateTime
    endDate   DateTime?

    cancelAtPeriodEnd Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    payments Payment[]

    @@index([userId])
    @@index([status])
    @@index([providerSubscriptionId])
    @@map("subscription")
}

model Payment {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    subscriptionId String?
    subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

    plan Plan

    amount   Decimal @db.Decimal(10, 2)
    currency String  @default("INR")

    status            PaymentStatus @default(PENDING)
    provider          String?
    providerOrderId   String?
    providerPaymentId String?

    paidAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([subscriptionId])
    @@index([status])
    @@index([providerOrderId])
    @@index([providerPaymentId])
    @@map("payment")
}

model ReferralCode {
    id String @id @default(uuid())

    code String @unique

    userId String @unique
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("referral_code")
}

model Referral {
    id String @id @default(uuid())

    code String

    senderId String
    sender   User   @relation("ReferralSender", fields: [senderId], references: [id], onDelete: Cascade)

    receiverId String?
    receiver   User?   @relation("ReferralReceiver", fields: [receiverId], references: [id], onDelete: SetNull)

    status ReferralStatus @default(PENDING)
    amount Decimal        @default(0) @db.Decimal(10, 2)

    description String?

    completedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([senderId])
    @@index([receiverId])
    @@index([code])
    @@index([status])
    @@map("referral")
}

model PostBookmark {
    id String @id @default(uuid())

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    postId String
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([userId, postId])
    @@index([userId])
    @@index([postId])
    @@map("post_bookmark")
}

model Document {
    id        String          @id @default(uuid())
    filename  String
    title     String?
    metadata  Json?
    chunks    DocumentChunk[]
    createdAt DateTime        @default(now())
    updatedAt DateTime        @updatedAt

    @@map("documents")
}

model DocumentChunk {
    id         String                      @id @default(uuid())
    documentId String
    chunkIndex Int
    content    String
    embedding  Unsupported("vector(768)")?
    metadata   Json?
    document   Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
    createdAt  DateTime                    @default(now())

    @@index([documentId])
    @@map("document_chunks")
}
